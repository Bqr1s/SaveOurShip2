<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<SaveOurShip2.GlobalUnlockDef>
		<defName>GlobalUnlocks</defName>
		<AllShipsUnlockedFlag>false</AllShipsUnlockedFlag>
	</SaveOurShip2.GlobalUnlockDef>
	
	<SaveOurShip2.DodgeChanceSubmodScaleDef>
		<defName>DodgeChanceSubmodScale</defName>
		<multiplierList>
			<!-- Submods can add list items in case they allow reaching higher TWR than normal SOS 2 
			     in that case player ship dodge chance goes to high, ship battles becoime too easy
				 so nerfing multiplers (<1) are encouraged here. Allowed range: 0.1 to 1 -->
			<li>1.0</li>
		</multiplierList>
	</SaveOurShip2.DodgeChanceSubmodScaleDef>

	<SaveOurShip2.ScanFindingChancesDef>
		<defName>ScanFindingChances</defName>
		<!-- Because SOS 2 accepts support requests about core features working even with submods active,
		this weight will be capped in code to no more than 66.7% chance of finding pre-made site,
		so that optios can't be almost excluded by this weight being too high.
        Default weight of 1 means that there is 1 of 6 chance to to find a pre-made site when scanning mode
		is scan for sites, as other options have a combined weight of 5 Weiht 0f 5 hewe will mean
		50% chance to find a pre-made site in scan for sites mode -->
		<PremadeSiteWeight>1.0</PremadeSiteWeight>
	</SaveOurShip2.ScanFindingChancesDef>
</Defs>