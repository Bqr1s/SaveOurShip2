<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Gravship airlock: vanilla autodoor art + an integrated vacuum barrier. This whole folder is
	     Odyssey-gated, so no MayRequire is needed - it exists only where vacuum and gravships do. -->
	<ThingDef ParentName="DoorBase">
		<defName>GravshipAirlock</defName>
		<label>vacuum airlock</label>
		<description>An autodoor with an integrated vacuum barrier. Keeps air inside and enemies outside.</description>
		<thingClass>SaveOurShip2.Building_GravshipAirlock</thingClass>
		<graphicData>
			<texPath>Things/Building/Door/Autodoor_Mover</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconPath>Things/Building/Door/Autodoor_MenuIcon</uiIconPath>
		<costStuffCount>60</costStuffCount>
		<stuffCategories Inherit="False">
			<li>Metallic</li>
		</stuffCategories>
		<costList>
			<ComponentIndustrial>3</ComponentIndustrial>
			<GravlitePanel>2</GravlitePanel>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>100</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
		</comps>
		<building>
			<isStuffableAirtight>true</isStuffableAirtight>
		</building>
		<researchPrerequisites>
			<li>Autodoors</li>
		</researchPrerequisites>
		<designationCategory>Odyssey</designationCategory>
	</ThingDef>

</Defs>
